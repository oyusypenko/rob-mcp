# rob-mcp environment — every var documented in docs/developers/runbooks/env-inventory.md.
# Copy to .env for serve mode; the local stdio MCP needs only RPC_URL_4663.
# NEVER commit a real .env. No private keys exist in this service — by design (no-custody rule).

# --- chain reads (all modes) ---
RPC_URL_4663=                  # required. https:// or wss:// RPC for Robinhood Chain mainnet
RPC_URL_4663_ARCHIVE=          # optional. archive RPC (Dwellir/Alchemy) for whale backfill; falls back to RPC_URL_4663
CHAIN_ID=4663                  # fail-closed identity gate — must equal live eth_chainId at boot

# --- serve mode (hosted paid API + MCP) ---
PORT=8402
SQLITE_PATH=./rob.db          # /data/rob.db on Fly (volume-backed)
TOKENS_PATH=./data/tokens.json
ISSUER_ADDRESSES=              # comma-separated issuer/Authorized Participant addresses for mint/redeem classification
WHALE_MIN_USD=50000            # whale threshold — config, never hardcoded (no-market-metrics rule)
FREE_CALLS_PER_DAY=20          # free-tier calls per IP per day before the 402 challenge
LOG_LEVEL=info

# --- x402 payments (serve mode only) ---
X402_PAY_TO=                   # USDC receiving address on Base — the ONLY address this service knows
X402_NETWORK=eip155:84532      # eip155:8453 = Base mainnet, eip155:84532 = Base Sepolia
X402_FACILITATOR_URL=          # optional override; defaults per network (testnet: https://facilitator.x402.org)
CDP_API_KEY_ID=                # mainnet CDP facilitator auth only
CDP_API_KEY_SECRET=            # mainnet CDP facilitator auth only

# --- oracle fallback (optional; tickers without a Chainlink feed) ---
FALLBACK_QUOTE_API_URL=
FALLBACK_QUOTE_API_KEY=
