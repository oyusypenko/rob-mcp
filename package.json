{
  "name": "rob-mcp",
  "version": "0.0.1",
  "description": "MCP server + x402-paid API for Robinhood Chain (4663) tokenized-stock data — agent-callable premium/discount, DEX liquidity, and whale-flow tools.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "rob-mcp": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/cli.ts",
    "serve": "bun run src/cli.ts serve",
    "scan": "bun run src/cli.ts scan",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bash scripts/validate.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify-tokens": "bun scripts/verify-tokens.ts",
    "sync-codex": "bun scripts/sync-codex.ts",
    "codex:parity": "bun scripts/verify-codex-parity.ts",
    "codex:setup": "bun scripts/setup-codex.ts",
    "site:data": "bun scripts/site-generate.ts",
    "site:dev": "bun run site:data && astro dev --root site",
    "site:build": "bun run site:data && astro build --root site",
    "site:check": "bun run site:data && astro check --root site && astro build --root site && bun scripts/site-check.ts",
    "site:lighthouse": "lhci autorun --config=site/lighthouserc.json"
  },
  "dependencies": {
    "@coinbase/x402": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@x402/core": "2.20.0",
    "@x402/evm": "2.20.0",
    "@x402/extensions": "2.20.0",
    "@x402/fetch": "2.20.0",
    "@x402/hono": "2.20.0",
    "@x402/mcp": "2.20.0",
    "hono": "4.12.28",
    "viem": "2.55.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "@lhci/cli": "0.15.1",
    "@types/bun": "1.3.14",
    "astro": "7.1.5",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3"
  }
}
