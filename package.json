{
  "name": "rob-mcp",
  "version": "0.0.1",
  "description": "MCP server + x402-paid API for Robinhood Chain (4663) tokenized-stock data — agent-callable premium/discount, DEX liquidity, and whale-flow tools.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "rob-mcp": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/cli.ts",
    "serve": "bun run src/cli.ts serve",
    "scan": "bun run src/cli.ts scan",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bash scripts/validate.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify-tokens": "bun scripts/verify-tokens.ts",
    "sync-codex": "bun scripts/sync-codex.ts"
  },
  "dependencies": {
    "@coinbase/x402": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@x402/core": "2.20.0",
    "@x402/evm": "2.20.0",
    "@x402/fetch": "2.20.0",
    "@x402/hono": "2.20.0",
    "@x402/mcp": "2.20.0",
    "hono": "4.12.28",
    "viem": "2.55.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.6.0",
    "typescript": "^5.6.0"
  }
}
